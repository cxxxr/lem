#!/bin/sh
# lem — start Lem on Clysm (the desktop application), or, when it is already
# running, show its window at once: the application stays resident (it only
# hides its window when the window is closed, "resident" in package.json),
# and this tells it what to do through its socket, as emacsclient does.
#   lem [FILE...]       show Lem (and open the files)
#   lem --daemon        start Lem with its window hidden, to show it later
#   lem --stop          end Lem (C-x C-c ends the editor, and a new one waits,
#                       hidden, so that the next lem shows it at once)
#   lem --install       start Lem hidden when you log in, and add Lem to the
#                       applications menu (through this command); Linux
# Lem shows its window in less than 10 ms when it is running; started, it
# takes under a second (from its heap image, see frontends/clysm/README.md).
# follow symbolic links (e.g. ~/.local/bin/lem -> .../desktop/lem), so that
# dir is where the application is
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
dir=$(cd "$(dirname "$self")" && pwd)
data=${CLYSM_USER_DATA:-${XDG_CONFIG_HOME:-$HOME/.config}/Lem}
[ "$(uname)" = Darwin ] && data=${CLYSM_USER_DATA:-$HOME/Library/Application Support/Lem}
socket=$data/resident.sock

daemon=
case $1 in
  --daemon) daemon=1; shift ;;
  --stop)
    [ -S "$socket" ] && printf 'stop\n' | nc -U -N "$socket" 2> /dev/null
    exit 0 ;;
  --install)
    apps=${XDG_DATA_HOME:-$HOME/.local/share}/applications
    autostart=${XDG_CONFIG_HOME:-$HOME/.config}/autostart
    icons=${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps
    mkdir -p "$apps" "$autostart" "$icons"
    # the icon; the window finds this entry by its name, lem-clysm (the
    # desktopName of package.json), so that the dock shows it as Lem
    [ -f "$dir/lem.svg" ] && cp "$dir/lem.svg" "$icons/lem-clysm.svg"
    entry() {   # entry NAME EXEC [EXTRA]
      printf '[Desktop Entry]\nType=Application\nName=%s\nComment=%s\nExec=%s\nIcon=lem-clysm\nStartupWMClass=lem-clysm\nTerminal=false\nCategories=Development;TextEditor;\n%b' \
        "$1" "Lem, the Common Lisp editor, on Clysm" "$2" "$3"
    }
    entry Lem "\"$dir/lem\" %F" \
      "MimeType=text/plain;text/x-lisp;text/x-common-lisp;text/x-makefile;text/x-c;text/x-c++;application/x-shellscript;\n" \
      > "$apps/lem-clysm.desktop"
    entry "Lem (resident)" "\"$dir/lem\" --daemon" "X-GNOME-Autostart-enabled=true\nNoDisplay=true\n" \
      > "$autostart/lem-clysm.desktop"
    echo "installed $apps/lem-clysm.desktop and $autostart/lem-clysm.desktop"
    exit 0 ;;
esac

# the lines for the application: "open FILE" for each file, then "show"
lines() {
  for f in "$@"; do
    case $f in /*) ;; *) f=$PWD/$f ;; esac
    printf 'open %s\n' "$f"
  done
  [ -n "$daemon" ] || printf 'show\n'
}

if [ -S "$socket" ]; then
  if command -v nc > /dev/null 2>&1; then
    lines "$@" | nc -U -N "$socket" 2> /dev/null || lines "$@" | nc -U "$socket" 2> /dev/null
  else
    lines "$@" | node -e "const s = require('net').connect(process.argv[1]);
      process.stdin.pipe(s); s.on('error', () => process.exit(1))" "$socket"
  fi && exit 0
fi

# not running: start it (in the background, its window shown when it is ready)
cd "$dir" || exit 1
electron=$dir/node_modules/electron/dist/electron
[ "$(uname)" = Darwin ] && electron=$dir/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron
for f in "$@"; do
  case $f in /*) ;; *) f=$OLDPWD/$f ;; esac
  set -- "$@" "$f"
  shift
done
nohup "$electron" . ${daemon:+--hidden} "$@" > /dev/null 2>&1 &
