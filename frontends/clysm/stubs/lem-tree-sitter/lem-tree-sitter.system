;;;; Lem's tree-sitter integration loads the native tree-sitter library;
;;;; on Clysm the modes that would use it highlight with their own
;;;; grammars, as Lem does where the library is missing.
(defsystem "lem-tree-sitter"
  :description "Lem without tree-sitter (Clysm)"
  :components ((:file "lem-tree-sitter")))
