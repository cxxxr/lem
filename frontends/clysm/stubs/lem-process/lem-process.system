;;;; Lem's subprocesses (lem-process, with async-process): a page cannot run
;;;; programs.  Lem's Lisp mode names them to start other Lisp processes
;;;; (M-x slime); here they say that it cannot.
(defsystem "lem-process"
  :description "Lem without subprocesses (Clysm)"
  :components ((:file "lem-process")))
